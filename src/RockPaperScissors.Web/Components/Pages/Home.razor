@page "/"
@rendermode InteractiveServer

<PageTitle>Rots, papier, schaar</PageTitle>

<h1>Rots, papier, schaar</h1>

<section>
    <label>
        Aantal rondes (1-@GameSession.MaxRounds):
        <input type="number" min="1" max="@GameSession.MaxRounds" @bind="_requestedRounds" />
    </label>
    <label>
        Tegenstander:
        <select @bind="_opponentName">
            @foreach (OpponentOption option in Opponents.All)
            {
                <option value="@option.Name">@option.Name (@option.Description)</option>
            }
        </select>
    </label>
    <button @onclick="StartGame">Start spel</button>
    @if (_error is not null)
    {
        <p class="error">@_error</p>
    }
</section>

@if (_session is not null)
{
    <section>
        <p>Ronde @_session.History.Count van @_session.TotalRounds gespeeld</p>

        <div class="moves">
            @foreach (Move move in Enum.GetValues<Move>())
            {
                <button disabled="@_session.IsFinished" @onclick="() => Play(move)">@MoveNames.NameOf(move)</button>
            }
        </div>

        @if (_session.History.Count > 0)
        {
            Round last = _session.History[^1];
            <p>Jij: @MoveNames.NameOf(last.Player), computer: @MoveNames.NameOf(last.Computer). @RoundResult(last.Outcome)</p>
        }

        <p>Gewonnen @_session.Wins, verloren @_session.Losses, gelijk @_session.Draws</p>

        @if (_session.IsFinished)
        {
            <p><strong>@GameResult(_session)</strong></p>
        }
    </section>
}

@code {
    private int? _requestedRounds = 5;
    private string _opponentName = Opponents.Default.Name;
    private string? _error;

    // The session holds the history, the only game state; everything shown is derived from it.
    private GameSession? _session;

    private void StartGame()
    {
        if (_requestedRounds is not int rounds || rounds < 1 || rounds > GameSession.MaxRounds)
        {
            _error = $"Kies een heel getal van 1 tot en met {GameSession.MaxRounds}.";
            return;
        }

        // The select only offers listed names, but the value comes from the browser, so it is checked anyway.
        OpponentOption? opponent = Opponents.All.FirstOrDefault(option => option.Name == _opponentName);
        if (opponent is null)
        {
            _error = "Kies een tegenstander uit de lijst.";
            return;
        }

        _error = null;
        // A new computer player with its own Random per game: Random is not thread-safe,
        // so nothing is shared between users or circuits.
        _session = new GameSession(rounds, opponent.Create(new Random()));
    }

    // The buttons are disabled once the game is finished, so PlayRound never throws here.
    private void Play(Move move) => _session?.PlayRound(move);

    private static string RoundResult(Outcome outcome) => outcome switch
    {
        Outcome.Win => "Je wint deze ronde!",
        Outcome.Lose => "De computer wint deze ronde.",
        _ => "Gelijkspel.",
    };

    private static string GameResult(GameSession session) =>
        session.Wins > session.Losses ? "Jij wint het spel!"
        : session.Losses > session.Wins ? "De computer wint het spel."
        : "Het spel eindigt gelijk.";
}
